# Copy values into your ignored .env file; never commit credentials.
OPENAI_API_KEY=
YOUTUBE_API_KEY=
# Optional private config file; default is config/youtube_coverage.json.
# YOUTUBE_COVERAGE_CONFIG=config/youtube_coverage.local.json
# Optional HTTP(S) proxy for authorized transcript access, never restriction evasion.
# YOUTUBE_TRANSCRIPT_PROXY=http://username:password@proxy-host:port
# Optional remote MCP transport settings; only used when configured.
# YOUTUBE_MCP_URL=https://your-server.example/mcp
# YOUTUBE_MCP_TOKEN=
# Optional approved Reddit API access; module stays off until configured.
# REDDIT_ACCESS_TOKEN=
# Local market snapshot read only by the final central node.
# CENTRAL_MARKET_CONTEXT_PATH=data_cache/market_snapshot.json
